# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database Configuration (Neon.tech / PostgreSQL)
DATABASE_URL=postgresql://username:password@ep-xyz.ap-southeast-1.aws.neon.tech/neondb?sslmode=verify-full

# JWT Secrets
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_SECRET=your_refresh_token_secret_key_here
REFRESH_TOKEN_EXPIRES_IN=7d

# AWS S3 - upload tệp (avatar, ảnh bìa khóa học, tài liệu bài học). Tùy chọn: thiếu thì API upload trả 503.
# Bucket chặn public, chỉ mở Public Read cho prefix public/* (bucket policy). Cần CORS cho PUT/GET từ CLIENT_URL.
# IAM cần: s3:PutObject, s3:GetObject, s3:DeleteObject, s3:ListBucket (để HeadObject trả 404 đúng).
AWS_REGION=ap-southeast-1
S3_BUCKET=your-bucket-name
# Chỉ cần khi chạy local. Khi deploy trên EC2/ECS hãy dùng IAM Role và bỏ 2 dòng này.
AWS_ACCESS_KEY_ID=your_access_key_id
AWS_SECRET_ACCESS_KEY=your_secret_access_key
# Tùy chọn: domain CloudFront/riêng cho tệp public, không có dấu / ở cuối
# S3_PUBLIC_BASE_URL=https://cdn.example.com

# Google Gemini - AI sinh câu hỏi trắc nghiệm. Tùy chọn: thiếu thì API /ai/* trả 503.
# Lấy key tại https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key
# Tùy chọn: tên model (mặc định gemini-flash-latest). Xem danh sách: GET https://generativelanguage.googleapis.com/v1beta/models
# GEMINI_MODEL=gemini-3.8-flash
# Tùy chọn: model dự phòng khi model chính quá tải/bị ngừng (mặc định gemini-flash-lite-latest, để rỗng = tắt)
# GEMINI_FALLBACK_MODEL=gemini-flash-lite-latest
