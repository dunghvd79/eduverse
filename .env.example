# EduVerse — biến môi trường cho Docker Compose (docs/architecture/deployment.md)
# Cách dùng: sao chép file này thành ".env" (cùng thư mục) rồi sửa giá trị. KHÔNG commit file .env.

# Cổng mở ra máy của bạn: http://localhost:<FRONTEND_PORT>
FRONTEND_PORT=8080

# PostgreSQL chạy trong container. Mật khẩu chỉ nên gồm chữ và số (được ghép vào chuỗi kết nối).
POSTGRES_USER=eduverse
POSTGRES_PASSWORD=doi_mat_khau_nay_truoc_khi_demo_1
POSTGRES_DB=eduverse

# JWT: hai khóa phải KHÁC nhau, mỗi khóa là chuỗi ngẫu nhiên dài từ 32 ký tự. Các giá trị dưới đây chỉ là mẫu.
JWT_SECRET=doi-khoa-jwt-nay-thanh-chuoi-ngau-nhien-dai-32-ky-tu-a
REFRESH_TOKEN_SECRET=doi-khoa-refresh-nay-thanh-chuoi-ngau-nhien-dai-32-ky-tu-b

# Tùy chọn: development (mặc định, có in link đặt lại mật khẩu ra log) hoặc production (cookie đăng nhập yêu cầu HTTPS)
# NODE_ENV=development

# Tùy chọn: đặt false để bỏ qua bước tự tạo bảng và nạp dữ liệu mẫu khi CSDL còn trống
# DB_AUTO_INIT=true

# Tùy chọn: AI sinh câu hỏi trắc nghiệm (thiếu thì API /ai/* trả 503). Lấy key tại https://aistudio.google.com/apikey
GEMINI_API_KEY=
# GEMINI_MODEL=

# Tùy chọn: AWS S3. Để trống cả hai dòng đầu thì tệp tải lên được lưu trong volume của Docker.
AWS_REGION=
S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
